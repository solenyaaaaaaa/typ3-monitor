    "hempbarn_livingsoil": {
      "strains": [
        "Don Mega",
        "RS54",
        "Sherb Stack"
      ],
      "descriptions": {
        "RS54": "This smells like a creamy version of Zkittlez to me. It has that \u201csweet zkittlez\u201d smell but with an extra creamy twist to it. Nice middle of the road hybrid effects.",
        "Sherb Stack": "Unreal bag appeal with that unmistakable funky, yet gassy Sherb profile. It definitely leans on the Sunset Sherbet side of the cross with potent, slightly indica leaning effects.",
        "Don Mega": "We usually do organic soil runs of this since it can be really finicky, but this batch might be the best one yet. Reeks of GMO and old school Kush/OG with Indica dominant effects."
      },
      "last_seen": "2026-05-19T12:14:16.230912+00:00"
    },
